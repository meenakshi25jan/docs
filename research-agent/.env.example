# Application
DEBUG=false
APP_NAME=Research Agent

# Database (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./data/research_agent.db

# PostgreSQL example (uncomment to use)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/research_agent

# Crawler
DEFAULT_DEPTH=2
DEFAULT_MAX_PAGES=100
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RATE_LIMIT_DELAY=0.5
MAX_CONCURRENT_REQUESTS=10
RESPECT_ROBOTS_TXT=true
USE_PLAYWRIGHT=true

# Search
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=50

# Google Custom Search (optional)
# GOOGLE_API_KEY=your_google_api_key
# GOOGLE_CSE_ID=your_custom_search_engine_id

# Bing Search API (optional)
# BING_API_KEY=your_bing_api_key

# AI / LLM
LLM_PROVIDER=none
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-4o-mini

# Ollama (optional)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Local LLM (OpenAI-compatible endpoint)
# LLM_PROVIDER=local
# LOCAL_LLM_URL=http://localhost:8080/v1/chat/completions
# LOCAL_LLM_MODEL=local

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_COLLECTION=research_pages

# API
API_HOST=0.0.0.0
API_PORT=8000
# API_KEY=your-secret-api-key
CORS_ORIGINS=["*"]
