# Application
APP_NAME=AI English Teacher
DEBUG=true

# Database — PostgreSQL (recommended) or SQLite (zero-setup local dev)
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_english_teacher
# SQLite fallback (no Docker required):
DATABASE_URL=sqlite+aiosqlite:///./ai_english_teacher.db

# JWT authentication (required)
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
