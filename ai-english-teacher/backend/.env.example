# Application
APP_NAME=AI English Teacher
APP_ENV=development
DEBUG=true

# Database — PostgreSQL/Neon (recommended) or SQLite (zero-setup local dev)
# Neon example:
# DATABASE_URL=postgresql+asyncpg://user:password@your_neon_host/your_db?sslmode=require
# SQLite fallback:
DATABASE_URL=sqlite+aiosqlite:///./ai_english_teacher.db

# JWT authentication (required)
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# xAI Grok (required for grammar/conversation AI)
XAI_API_KEY=your_grok_api_key
GROK_MODEL=grok-2-1212

# OpenAI Whisper (required for /audio-conversation speech-to-text)
OPENAI_API_KEY=your_openai_api_key
WHISPER_MODEL=whisper-1

# Edge TTS voices (no API key required)
TTS_VOICE_FEMALE=en-US-JennyNeural
TTS_VOICE_MALE=en-US-GuyNeural

# RAG embedding vector size — must match the active embedding model.
# Default 384 = sentence-transformers/all-MiniLM-L6-v2 (no extra API key).
# If you switch providers (e.g. OpenAI text-embedding-3-small = 1536), change
# this value AND run a migration to ALTER the vector column dimension, then
# regenerate all stored embeddings (vectors are not comparable across models).
EMBEDDING_DIMENSION=384

# Knowledge ingestion chunking (characters)
INGESTION_CHUNK_SIZE=1000
INGESTION_CHUNK_OVERLAP=200

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
