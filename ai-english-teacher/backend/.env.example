# AI English Teacher API - Environment Variables

APP_NAME=AI English Teacher
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_english_teacher
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cognitive orchestration (default true) — set false to use LangGraph fallback only
COGNITIVE_ORCHESTRATION_ENABLED=true

# Azure OpenAI — Microsoft Copilot backend (recommended for cloud)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# LLM provider: auto | copilot | azure | openai | groq | ollama | mock
AI_PROVIDER=auto

# OpenAI / Groq (alternative to Azure)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
# Groq example: OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Ollama (local only — leave empty on Render)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

CORS_ORIGINS=["http://localhost:3000"]
