# Copy to .env in this directory before running docker compose
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# Neon (recommended) or any PostgreSQL with pgvector
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32

# Your public URL (IP or domain) — used for CORS
PUBLIC_URL=http://YOUR_VM_PUBLIC_IP

# Mobile app (.env in mobile/ folder):
# EXPO_PUBLIC_API_URL=http://YOUR_VM_PUBLIC_IP/api/v1

# ── AI Provider ───────────────────────────────────────────────────────────────
# Options: ollama | copilot | openai | mock
AI_PROVIDER=ollama

# Ollama (runs on same VM via docker compose profile)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Azure OpenAI / Copilot (if AI_PROVIDER=copilot)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Groq / OpenAI-compatible (if AI_PROVIDER=openai)
# OPENAI_API_KEY=gsk_xxx
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant

# ── Optional ──────────────────────────────────────────────────────────────────
SKIP_MIGRATIONS=false
DEBUG=false
