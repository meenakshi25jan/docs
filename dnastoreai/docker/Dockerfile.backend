FROM python:3.12-slim AS backend

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml backend/
RUN pip install --no-cache-dir -e "./backend[dev]" 2>/dev/null || \
    pip install --no-cache-dir fastapi uvicorn pydantic pydantic-settings numpy pandas scipy biopython networkx torch transformers loguru sqlalchemy aiosqlite reedsolo python-multipart aiofiles httpx jinja2 matplotlib seaborn pillow python-docx python-pptx pypdf chromadb pytest pytest-asyncio pytest-cov

COPY backend/ /app/backend/
WORKDIR /app/backend

RUN pip install --no-cache-dir -e .

EXPOSE 8000

CMD ["uvicorn", "dnastoreai.main:app", "--host", "0.0.0.0", "--port", "8000"]
