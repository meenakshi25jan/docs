# Neon Postgres connection string (use the asyncpg-compatible form)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-host>/<dbname>?ssl=require

# LLM API (variable names kept as GROK_* from earlier draft; currently using Groq)
GROK_API_KEY=your_groq_api_key_here
GROK_API_BASE=https://api.groq.com/openai/v1
GROK_MODEL=openai/gpt-oss-120b

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS - your frontend dev URL
FRONTEND_ORIGIN=http://localhost:5173
